#!/usr/bin/env bash
# Rebuild the bounded four-package acceptance environment without touching existing build outputs.
set -euo pipefail

prepare_only=false
if [[ "${1:-}" == --prepare ]]; then
    prepare_only=true
    shift
fi
if [[ $# -gt 2 || "${1:-}" == --* ]]; then
    echo "Usage: bash bin/verify-packages [--prepare] [workspace [dependency-cache]]" >&2
    exit 1
fi
ui_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace="${1:-$(dirname "$ui_root")}"
cache="${2:-$HOME/.m2/repository}"
repos=(phylospec phylospec-ui PopFunc beast-phylonco RelaxClockAveraging CalibratedCPP)

# Maven uses JAVA_HOME when set; keep source launchers and child JVMs on the same JDK.
if [[ -n "${JAVA_HOME:-}" ]]; then
    export PATH="$JAVA_HOME/bin:$PATH"
fi
# Maven -D properties alone are not inherited by ProcessBuilder's independent JVMs.
export JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:+$JAVA_TOOL_OPTIONS }-Djava.only=true"
for command in git rsync shasum mvn java tar; do
    command -v "$command" >/dev/null || { echo "Missing command: $command" >&2; exit 1; }
done
java_version="$(java -XshowSettings:properties -version 2>&1 | awk '$1 == "java.specification.version" { print $3 }')"
if [[ ! "$java_version" =~ ^[0-9]+$ ]] || [[ "$java_version" -lt 25 ]]; then
    echo "JDK 25 or later is required; selected Java version: ${java_version:-unknown}. Set JAVA_HOME and PATH." >&2
    exit 1
fi
[[ -d "$cache" ]] || { echo "Missing Maven dependency cache: $cache" >&2; exit 1; }
workspace="$(cd "$workspace" && pwd)"
cache="$(cd "$cache" && pwd)"
# Phylonco inherits these locally installed parent POMs; they are not built by the six-repo reactor.
parents=(io/github/linguaphylo/linguaphylo/1.6.1/linguaphylo-1.6.1.pom
         io/github/linguaphylo/lphybeast-root/1.3.0/lphybeast-root-1.3.0.pom)
for parent in "${parents[@]}"; do
    [[ -f "$cache/$parent" ]] || {
        echo "Missing prerequisite parent POM: $parent. See README: Source and dependency handoff." >&2
        exit 1
    }
done
for repo in "${repos[@]}"; do
    git -C "$workspace/$repo" rev-parse --show-toplevel >/dev/null
done

run_root="$(mktemp -d /private/tmp/phylospec-rebuild.XXXXXX)"
sources="$run_root/sources"
repository="$run_root/maven-repository"
evidence="$run_root/evidence"
mkdir -p "$sources" "$repository" "$evidence" "$run_root/javafx-cache"
echo "Rebuild directory: $run_root"
echo "This directory is retained on success or failure. Existing checkouts and Maven cache are read-only inputs."
mvn -version > "$evidence/toolchain.txt" 2>&1
printf 'repository\tcommit\tbranch\torigin\tsource_archive\n' > "$evidence/sources.tsv"

# Include current uncommitted source, but never an old target or ignored local build artifact.
for repo in "${repos[@]}"; do
    source_root="$workspace/$repo"
    mkdir -p "$sources/$repo"
    git -C "$source_root" ls-files -z --cached --others --exclude-standard \
        -- . ':!:target/**' ':!:**/target/**' |
        while IFS= read -r -d '' file; do
            if [[ -f "$source_root/$file" || -L "$source_root/$file" ]]; then
                printf '%s\0' "$file"
            fi
        done > "$evidence/$repo.files"
    rsync -a --from0 --files-from="$evidence/$repo.files" "$source_root/" "$sources/$repo/"
    (
        cd "$sources/$repo"
        xargs -0 shasum -a 256 < "$evidence/$repo.files"
    ) > "$evidence/$repo.sha256"
    {
        printf 'Source: %s\n' "$source_root"
        git -C "$source_root" rev-parse HEAD
        git -C "$source_root" branch --show-current
        git -C "$source_root" status --short
    } > "$evidence/$repo.version.txt"
    git -C "$source_root" diff --binary HEAD -- . ':!:target/**' ':!:**/target/**' \
        > "$evidence/$repo.patch"
    git -C "$source_root" ls-files -z --others --exclude-standard \
        -- . ':!:target/**' ':!:**/target/**' > "$evidence/$repo.untracked.files"
    # Schema generation writes into src/main/java. Preserve the original inputs before building.
    COPYFILE_DISABLE=1 tar -czf "$evidence/$repo.source.tar.gz" -C "$sources" "$repo"
    printf '%s\t%s\t%s\t%s\t%s\n' "$repo" \
        "$(git -C "$source_root" rev-parse HEAD)" \
        "$(git -C "$source_root" branch --show-current)" \
        "$(git -C "$source_root" remote get-url origin)" \
        "$repo.source.tar.gz" >> "$evidence/sources.tsv"
done
(cd "$evidence" && shasum -a 256 ./*.source.tar.gz) > "$evidence/source-archives.sha256"

# Reuse only third-party dependencies. All first-party/native package artifacts below must be rebuilt.
rsync -a \
    --exclude='/org/phylospec/' \
    --exclude='/io/github/linguaphylo/popfunc-*/' \
    --exclude='/io/github/linguaphylo/beast-phylonco/' \
    --exclude='/io/github/linguaphylo/phylonco-*/' \
    --exclude='/io/github/beast2-dev/RelaxClockAveraging/' \
    --exclude='/io/github/beast2-dev/mixture-*/' \
    --exclude='/io/github/beast2-dev/phylospec-adapter/' \
    --exclude='/io/github/beast2-dev/calibratedcpp-*/' \
    "$cache/" "$repository/"
(
    cd "$repository"
    find . -type f \( -name '*.jar' -o -name '*.pom' \) -print0 | xargs -0 shasum -a 256
) > "$evidence/third-party.sha256"
(
    cd "$repository"
    shasum -a 256 "${parents[@]}"
) > "$evidence/required-parents.sha256"
# Cache provenance is an inventory, not a minimal dependency closure or proof of remote availability.
printf 'cache_path\trecorded_repository\n' > "$evidence/cache-origins.tsv"
while IFS= read -r -d '' metadata; do
    relative="${metadata#$repository/}"
    awk -v directory="${relative%/*}" '
        /^[^#].*>.*=$/ {
            sub(/=$/, "")
            split($0, entry, ">")
            if (entry[1] ~ /\.(jar|pom)$/)
                printf "%s/%s\t%s\n", directory, entry[1], (entry[2] == "" ? "local-install" : entry[2])
        }
    ' "$metadata" >> "$evidence/cache-origins.tsv"
done < <(find "$repository" -name _remote.repositories -type f -print0)
(
    cd "$sources/beast-phylonco"
    shasum -a 256 phylonco-beast/lib/*.jar
) > "$evidence/phylonco-vendored.sha256"
if "$prepare_only"; then
    echo "PREPARED ONLY: source archives and dependency inventory. No compilation, tests or MCMC executed."
    echo "Review before sharing; this is not a tested release or a complete dependency lockfile: $evidence"
    exit 0
fi

record_artifacts() {
    (
        cd "$sources"
        find . -type f -path '*/target/*' -name '*.jar' -print0 > "$evidence/built-jars.files"
        if [[ -s "$evidence/built-jars.files" ]]; then
            xargs -0 shasum -a 256 < "$evidence/built-jars.files"
        fi
    ) > "$evidence/built-jars.sha256"
}

run() {
    local name="$1" directory="$2"
    shift 2
    echo "Running $name (log: $evidence/$name.log)"
    {
        printf 'cd %q\n' "$directory"
        printf '%q ' "$@"
        printf '\n'
    } > "$evidence/$name.command"
    if (cd "$directory" && "$@") > "$evidence/$name.log" 2>&1; then
        printf '%s\tPASS\n' "$name" >> "$evidence/results.tsv"
    else
        printf '%s\tFAIL\n' "$name" >> "$evidence/results.tsv"
        record_artifacts
        tail -60 "$evidence/$name.log" >&2
        echo "Stopped at $name. Evidence retained in $run_root" >&2
        exit 1
    fi
}
maven=(mvn -o -B "-Dmaven.repo.local=$repository" -Djava.only=true -Dspotless.skip=true)

# Native modules are built unchanged; this gate is not their full scientific/numerical test suite.
run core "$sources/phylospec" "${maven[@]}" -pl integrations/beast3/java -am install
run popfunc-native "$sources/PopFunc" "${maven[@]}" -pl popfunc-beast -am -Dmaven.test.skip=true install
run popfunc-bundle "$sources/phylospec" "${maven[@]}" -Ppopfunc -pl integrations/beast3/popfunc -am -DskipTests install
run popfunc-tests "$sources/phylospec/integrations/beast3/popfunc" "${maven[@]}" \
    -Dtest=AncestralSelectionTest,PopFuncWorkflowTest -Dit.test=PackagedAdapterIT verify

# Phylonco's parent also lists an unrelated sibling LPhyBeast reactor. Build the required modules directly.
# Its published POM must resolve ${revision}; flatten only generated installation metadata in this snapshot.
flatten=(-Dflatten.mode=resolveCiFriendliesOnly -DupdatePomFile=true org.codehaus.mojo:flatten-maven-plugin:1.6.0:flatten)
run phylonco-parent "$sources/beast-phylonco" "${maven[@]}" -N "${flatten[@]}" install
run phylonco-native "$sources/beast-phylonco/phylonco-beast" "${maven[@]}" -Dmaven.test.skip=true "${flatten[@]}" install
run phylonco "$sources/beast-phylonco/phylonco-phylospec" "${maven[@]}" \
    -Dtest=GT16GeneratedTileTest,GT16ErrorModelEquivalenceTest,PhyloncoWorkflowTest,PhyloncoCoverageTest \
    -Dit.test=L86ReferenceIT,PackagedAdapterIT "${flatten[@]}" install

# CPP reference tests resolve the installed Relax classes, so build/install Relax first.
run clock-bundle "$sources/RelaxClockAveraging" "${maven[@]}" -pl phylospec-adapter -am -DskipTests install
run clock-tests "$sources/RelaxClockAveraging/phylospec-adapter" "${maven[@]}" \
    -Dtest=ReferenceDataTest,DatedTreeWorkflowTest -Dit.test=PackagedWorkflowIT verify
run calibrated-native "$sources/CalibratedCPP" "${maven[@]}" -pl calibratedcpp-beast -am -Dmaven.test.skip=true install
run calibrated "$sources/CalibratedCPP/phylospec-adapter" "${maven[@]}" \
    -Pcats-reference,primates-reference \
    -Dtest=WeightedDirichletTest,PartitionRatesWorkflowTest,CatsLikelihoodTest,CalibrationTextAdapterTest,ModelCoverageTest \
    -Dit.test=PrimatesReferenceIT,CatsReferenceIT,PackagedAdapterIT verify

mkdir -p "$sources/phylospec/target"
popfunc_bundle="$sources/phylospec/integrations/beast3/popfunc/target/phylospec-adapter"
phylonco_bundle="$sources/beast-phylonco/phylonco-phylospec/target/phylonco-phylospec-adapter-1.2.1"
run popfunc-l86 "$sources/phylospec" java -Dbeast.debug=true \
    -cp "$popfunc_bundle/*:$phylonco_bundle/*" \
    integrations/beast3/examples/popfunc-l86/L86Analysis.java \
    integrations/beast3/examples/popfunc-l86 "$sources/phylospec/target/popfunc-l86-checked"

run ui-acceptance "$sources/phylospec-ui" "${maven[@]}" "-Dphylospec.workspace=$sources" \
    "-Djavafx.cachedir=$run_root/javafx-cache" -DforkedProcessTimeoutInSeconds=240 -Pacceptance verify
# UI test classes follow their package paths and end in Test.java; require every class to run.
(
    cd "$sources/phylospec-ui/src/test/java"
    find . -type f -name '*Test.java' |
        sed -e 's#^\./##' -e 's#/#.#g' -e 's#\.java$##' |
        LC_ALL=C sort
) > "$evidence/ui-expected-suites.txt"
run ui-report-gate "$sources/phylospec-ui" awk -F '"' '
    NR == FNR { expected[$0] = 1; next }
    /<testsuite / {
        name = ""; tests = errors = failures = skipped = 0
        for (i = 1; i < NF; i++) {
            if ($i ~ / name=$/) name = $(i + 1)
            if ($i ~ / tests=$/) tests = $(i + 1) + 0
            if ($i ~ / errors=$/) errors = $(i + 1) + 0
            if ($i ~ / failures=$/) failures = $(i + 1) + 0
            if ($i ~ / skipped=$/) skipped = $(i + 1) + 0
        }
        total += tests; bad += errors + failures + skipped; suites++
        reported[name] += tests
        if (name == "org.phylospec.ui.PackageDeliveryTest") delivery = tests
    }
    END {
        for (name in expected) {
            expectedSuites++
            if (reported[name] <= 0) {
                printf "Missing or empty test suite: %s\n", name
                missing++
            }
        }
        printf "Suites: %d; expected suites: %d; tests: %d; failures/errors/skips: %d; delivery tests: %d\n", suites, expectedSuites, total, bad, delivery
        if (expectedSuites == 0 || suites != expectedSuites || missing != 0 || total == 0 || bad != 0 || delivery != 4) exit 1
    }
' "$evidence/ui-expected-suites.txt" "$sources/phylospec-ui/target/acceptance-reports/"TEST-*.xml
record_artifacts
echo "PASS: bounded backend references and UI acceptance rebuilt from the recorded source snapshots."
echo "Results, commands, logs, source and dependency hashes: $evidence"
